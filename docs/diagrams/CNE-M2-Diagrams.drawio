        <mxCell id="cicd-5" value="&lt;b&gt;GitHub repository&lt;/b&gt;&lt;br&gt;main protected by&lt;br&gt;4 required checks" style="shape=mxgraph.weblogos.github;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;strokeColor=none;fillColor=#24292F;fontSize=11;fontColor=#333333;pointerEvents=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="70" height="70" as="geometry" />
        </mxCell>
