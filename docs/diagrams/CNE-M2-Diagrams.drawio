        <mxCell id="cicd-7" value="" style="rounded=1;arcSize=6;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#66B2FF;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="250" y="80" width="1000" height="600" as="geometry" />
