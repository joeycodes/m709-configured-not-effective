        <mxCell id="cicd-8" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;imageAspect=0;html=1;fontSize=11;fontColor=#333333;image=data:image/png,;" vertex="1" parent="1">
