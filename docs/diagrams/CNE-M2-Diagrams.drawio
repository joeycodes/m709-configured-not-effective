        <mxCell id="infra-78" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#333333;" value="&lt;b&gt;rt-cne-tier2&lt;/b&gt;&lt;br&gt;10.100.0.0/14 → 10.100.2.4&lt;br&gt;0.0.0.0/0 → 10.100.2.4" vertex="1">
          <mxGeometry height="50" width="240" x="866" y="924" as="geometry" />
        </mxCell>
        <mxCell id="infra-79" parent="1" style="image;aspect=fixed;html=1;points=[];verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;fontColor=#333333;image=img/lib/azure2/networking/Network_Security_Groups.svg;imageBackground=none;" value="" vertex="1">
