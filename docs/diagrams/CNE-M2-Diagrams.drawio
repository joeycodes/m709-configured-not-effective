        <mxCell id="infra-80" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#333333;" value="&lt;b&gt;nsg-tier2-workload&lt;/b&gt;" vertex="1">
