        <mxCell id="cicd-2" value="&lt;b&gt;configured-not-effective&lt;/b&gt; · CI/CD pipeline (end of M2, October 2026)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="14" width="1200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cicd-3" value="Every change reaches Azure through GitHub Actions with short-lived OIDC tokens. Three layers of checks: Checkov on the source, Rego on the plan, and an assertion on what Azure deployed." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
