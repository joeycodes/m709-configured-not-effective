        <mxCell id="cicd-9" value="&lt;b&gt;GitHub Actions&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="306" y="98" width="200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cicd-10" value="" style="rounded=1;arcSize=6;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#1565C0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="270" y="140" width="960" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cicd-11" value="&lt;b&gt;On pull request · all four checks must pass before merge&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1565C0;" vertex="1" parent="1">
          <mxGeometry x="284" y="146" width="600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="cicd-12" value="&lt;b&gt;plan.yml › plan&lt;/b&gt;&lt;br&gt;terraform plan for the lab&lt;br&gt;→ &lt;b&gt;conftest test&lt;/b&gt; on the plan JSON&lt;br&gt;4 Rego rules: zone_tag, pip_tier0,&lt;br&gt;spoke_routes, nva_ip" style="rounded=1;arcSize=6;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C4C4C;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="290" y="180" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cicd-13" value="&lt;b&gt;plan.yml › plan-observability&lt;/b&gt;&lt;br&gt;terraform plan for the persistent layer" style="rounded=1;arcSize=6;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C4C4C;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="290" y="280" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cicd-14" value="&lt;b&gt;policy.yml › checkov&lt;/b&gt;&lt;br&gt;built-in rules on the Terraform source&lt;br&gt;e.g. every subnet has an NSG" style="rounded=1;arcSize=6;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C4C4C;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="610" y="180" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cicd-15" value="&lt;b&gt;policy.yml › conftest&lt;/b&gt;&lt;br&gt;&lt;b&gt;conftest verify&lt;/b&gt;: unit tests for each&lt;br&gt;Rego rule, each expects a deny" style="rounded=1;arcSize=6;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C4C4C;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="610" y="260" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cicd-16" value="Open Policy Agent&lt;br&gt;(Rego via conftest)" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;imageAspect=0;html=1;fontSize=11;fontColor=#333333;image=data:image/png,;" vertex="1" parent="1">
